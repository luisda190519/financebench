# ─── Benchmark Scripts Environment ────────────────────────────────────────────
# Copy this file to .env in the repo root (or set as environment variables).
# These variables are required when running benchmark scripts that hit the API
# or connect directly to MongoDB.

# JWT token for a benchmark user account.
# Obtain by logging in via the app and copying the token from localStorage,
# or by calling POST /api/auth/login and reading the `token` field.
BENCHMARK_TOKEN=<jwt-de-un-usuario-de-benchmark>

# Base URL of the running backend API.
BENCHMARK_API_URL=http://localhost:5000/api

# MongoDB connection string (only needed for aggregate.js which queries DB directly).
MONGODB_URI=mongodb://localhost:27017/viabilidad

# Optional: LLM model name tag to store in aggregate results for multi-model comparison.
BENCHMARK_MODEL_TAG=gpt-4o

# LLM providers used by scripts/runAPI.js (leave empty until you have your own keys).
GROQ_API_KEY=
DEEPSEEK_API_KEY=
